# Merge into the organization's Prometheus config. Prometheus must reach the private
# Compose network (backend:8000); never publish this port on the public interface.
rule_files:
  - /etc/prometheus/guardiano-alerts.yml
scrape_configs:
  - job_name: guardiano
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/guardiano_metrics_token
    static_configs:
      - targets: ['backend:8000']
# Add node_exporter (including textfile collector), blackbox HTTPS monitoring and
# Alertmanager receivers to your existing monitoring system. See the runbook.
