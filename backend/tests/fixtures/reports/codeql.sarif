{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.17.6",
          "rules": [
            {
              "id": "js/sql-injection",
              "name": "js/sql-injection",
              "shortDescription": { "text": "Database query built from user-controlled sources" },
              "fullDescription": { "text": "Building a database query from user-controlled sources is vulnerable to insertion of malicious code by the user." },
              "help": { "text": "Use parameterized queries (prepared statements) instead of string concatenation.", "markdown": "Use **parameterized queries** (prepared statements) instead of string concatenation." },
              "helpUri": "https://codeql.github.com/codeql-query-help/javascript/js-sql-injection/",
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": ["security", "external/cwe/cwe-089", "external/cwe/cwe-090"], "security-severity": "8.8", "precision": "high" }
            },
            {
              "id": "js/reflected-xss",
              "name": "js/reflected-xss",
              "shortDescription": { "text": "Reflected cross-site scripting" },
              "fullDescription": { "text": "Writing user input directly to an HTTP response allows for a cross-site scripting vulnerability." },
              "help": { "text": "Encode or sanitize user input before writing it to the response; prefer a templating engine with auto-escaping." },
              "helpUri": "https://codeql.github.com/codeql-query-help/javascript/js-reflected-xss/",
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": ["security", "external/cwe/cwe-079", "external/cwe/cwe-116"], "security-severity": "6.1" }
            },
            {
              "id": "js/path-injection",
              "name": "js/path-injection",
              "shortDescription": { "text": "Uncontrolled data used in path expression" },
              "fullDescription": { "text": "Accessing paths influenced by users can allow an attacker to access unexpected resources." },
              "help": { "text": "Normalize the path and verify it stays within an allow-listed root directory." },
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": ["security", "external/cwe/cwe-022", "external/cwe/cwe-023"], "security-severity": "7.5" }
            },
            {
              "id": "js/hardcoded-credentials",
              "name": "js/hardcoded-credentials",
              "shortDescription": { "text": "Hard-coded credentials" },
              "fullDescription": { "text": "Credentials are hard coded in the source code of the application." },
              "help": { "text": "Load secrets from a secret manager or environment variables and rotate the exposed credential." },
              "defaultConfiguration": { "level": "warning" },
              "properties": { "tags": ["security", "external/cwe/cwe-259", "external/cwe/cwe-798"], "security-severity": "9.8" }
            },
            {
              "id": "js/insecure-randomness",
              "name": "js/insecure-randomness",
              "shortDescription": { "text": "Insecure randomness" },
              "fullDescription": { "text": "Using a cryptographically weak pseudo-random number generator to generate a security-sensitive value may allow an attacker to predict what value will be generated." },
              "help": { "text": "Use crypto.randomBytes / crypto.randomUUID for security-sensitive values." },
              "defaultConfiguration": { "level": "warning" },
              "properties": { "tags": ["security", "external/cwe/cwe-338"], "security-severity": "7.8" }
            },
            {
              "id": "js/missing-rate-limiting",
              "name": "js/missing-rate-limiting",
              "shortDescription": { "text": "Missing rate limiting" },
              "fullDescription": { "text": "An HTTP request handler that performs expensive operations without restricting the rate at which operations can be carried out is vulnerable to denial-of-service attacks." },
              "help": { "text": "Add a rate limiting middleware such as express-rate-limit." },
              "defaultConfiguration": { "level": "warning" },
              "properties": { "tags": ["security", "external/cwe/cwe-770", "external/cwe/cwe-307", "external/cwe/cwe-400"], "security-severity": "7.5" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/sql-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": { "text": "This query string depends on a [user-provided value](1)." },
          "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/routes/orders.js", "uriBaseId": "%SRCROOT%" }, "region": { "startLine": 42, "startColumn": 23, "endColumn": 71, "snippet": { "text": "db.query(\"SELECT * FROM orders WHERE id = \" + req.params.id)" } } } } ]
        },
        {
          "ruleId": "js/reflected-xss",
          "ruleIndex": 1,
          "level": "error",
          "message": { "text": "Cross-site scripting vulnerability due to a [user-provided value](1)." },
          "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/routes/search.js" }, "region": { "startLine": 17, "snippet": { "text": "res.send(`<h1>Results for ${req.query.q}</h1>`)" } } } } ]
        },
        {
          "ruleId": "js/path-injection",
          "ruleIndex": 2,
          "level": "error",
          "message": { "text": "This path depends on a [user-provided value](1)." },
          "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/routes/files.js" }, "region": { "startLine": 28, "snippet": { "text": "fs.readFile(path.join(UPLOAD_DIR, req.query.name), ...)" } } } } ]
        },
        {
          "ruleId": "js/hardcoded-credentials",
          "ruleIndex": 3,
          "level": "warning",
          "message": { "text": "The hard-coded value \"sk_live_...\" is used as [authorization header](1)." },
          "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/config/payments.js" }, "region": { "startLine": 5 } } } ]
        },
        {
          "ruleId": "js/insecure-randomness",
          "ruleIndex": 4,
          "level": "warning",
          "message": { "text": "This uses a cryptographically insecure random number generated at [Math.random()](1) in a security context." },
          "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/auth/reset-token.js" }, "region": { "startLine": 11 } } } ]
        },
        {
          "ruleId": "js/missing-rate-limiting",
          "ruleIndex": 5,
          "level": "warning",
          "message": { "text": "This route handler performs [a database access](1), but is not rate-limited." },
          "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/routes/login.js" }, "region": { "startLine": 9 } } } ]
        }
      ]
    }
  ]
}
