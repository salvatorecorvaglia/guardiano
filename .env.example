# ---- Guardiano configuration -------------------------------------------------
# development | test | production  (production enforces a strong SECRET_KEY and Secure cookies)
ENV=development

# JWT signing key. REQUIRED in production: generate with `openssl rand -hex 32`.
SECRET_KEY=change-me-in-production-please-use-a-long-random-value

# First administrator, created automatically when the users table is empty.
GUARDIANO_ADMIN_EMAIL=admin@example.com
GUARDIANO_ADMIN_PASSWORD=ChangeMe-Admin-2026!

# Optional immutable PostgreSQL runtime image (release-images.env supplies a tested digest).
# POSTGRES_IMAGE=ghcr.io/your-org/guardiano/db@sha256:...
# Postgres (structured fields safely encode reserved characters in credentials)
POSTGRES_DB=guardiano
POSTGRES_USER=guardiano
POSTGRES_PASSWORD=guardiano
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# An explicit DATABASE_URL overrides the structured fields.
# DATABASE_URL=postgresql+psycopg://guardiano:guardiano@db:5432/guardiano

# HTTP
HTTP_PORT=8080
# CIDR of the TLS proxy / load balancer in front of the web container, whose X-Forwarded-For is trusted.
REAL_IP_FROM=127.0.0.1/32
# Comma-separated origins; only needed when the UI is served from a different origin than the API.
CORS_ORIGINS=

# Sessions
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
# Coarse throttle, keyed on the client address and counted inside each worker process: with
# WEB_CONCURRENCY workers the effective limit is that many times looser, and it resets on restart.
LOGIN_RATE_LIMIT=10/minute
# Per account and stored in the database, so it holds across workers, restarts and source addresses.
# The lock doubles with each further failure up to the cap; a successful sign-in or a password reset
# clears it.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600

# Uploads (applied to both the API and nginx client_max_body_size)
MAX_UPLOAD_MB=50
# Maximum normalized findings accepted in one report.
MAX_REPORT_FINDINGS=100000
MAX_REPORT_COMPONENTS=100000
# Database-wide limit, shared across API workers. Excess uploads return 503 for retry.
MAX_CONCURRENT_INGESTS=2

# Outbound requests (webhooks, issue trackers, exploitability feeds) are refused when the address they
# resolve to is on a private or reserved network, so a mistyped or hostile URL cannot be used to reach
# this network from the inside. List the hosts that are meant to be internal, comma-separated, e.g.
# jira.corp.internal,gitlab.corp.internal
OUTBOUND_ALLOW_HOSTS=

# Follow a SAST finding when its line moves, using the scanner's own fingerprint (SARIF
# partialFingerprints, Semgrep extra.fingerprint). Off by default: it changes which results count as
# the same finding.
DEDUP_FINGERPRINTS=false
# Treat the names different scanners give one package ecosystem (go / golang / go-module / gobinary)
# as the same when matching SCA findings, so one CVE reported by OSV, Trivy and Grype is one
# finding. Recommended for a new installation; review its effect before turning it on in an old one.
DEDUP_CANONICAL_ECOSYSTEMS=false

# Remediation SLA in days per severity (drives "overdue")
SLA_CRITICAL_DAYS=7
SLA_HIGH_DAYS=30
SLA_MEDIUM_DAYS=90
SLA_LOW_DAYS=180

# Public base URL, used for links inside notifications (e.g. https://guardiano.example.com)
PUBLIC_URL=

# Days before a risk acceptance ends that finding.risk_acceptance_expiring is sent; 0 = never.
RISK_ACCEPTANCE_WARNING_DAYS=14

# Risk-acceptance policy. FOUR_EYES: managers approve requests instead of accepting directly.
RISK_ACCEPTANCE_REQUIRE_EXPIRY=false
RISK_ACCEPTANCE_MAX_DAYS=0
RISK_ACCEPTANCE_FOUR_EYES=false

# What an unlisted licence counts as in the component inventory: allowed or review.
LICENSE_DEFAULT=allowed

# Exploitability feeds. Set INTEL_SYNC_ENABLED=false on an air-gapped install,
# or point the URLs at an internal mirror.
INTEL_SYNC_ENABLED=true
# Advisory ids (GHSA, PYSEC...) are looked up here for their CVE; empty turns the lookup off.
OSV_API_URL=https://api.osv.dev
# KEV_FEED_URL=
# EPSS_FEED_URL=
# Let exploitability weigh on asset risk scores (changes existing numbers).
RISK_USE_EXPLOITABILITY=false

# Encrypts issue-tracker tokens and two-factor secrets. Defaults to a key
# derived from SECRET_KEY, in which case rotating SECRET_KEY makes both unreadable. Set it once.
INTEGRATIONS_KEY=

# Two-factor authentication. Roles listed here are asked to enrol; nobody is locked out.
MFA_REQUIRED_ROLES=
# Optional enforcement for local browser sessions; empty preserves existing access.
MFA_ENFORCED_ROLES=

# Single sign-on. Without OIDC_ISSUER only local accounts can sign in.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_BUTTON_LABEL=Sign in with SSO
# OIDC_REDIRECT_URL=            # defaults to PUBLIC_URL + /api/v1/auth/oidc/callback
OIDC_GROUPS_CLAIM=groups
# OIDC_ROLE_MAP=idp-admins:admin,appsec:manager
OIDC_DEFAULT_ROLE=viewer
OIDC_AUTO_CREATE=true
# On a first single sign-on, adopt an existing local account with the same address. The address is only
# ever believed when the provider reports it as verified (email_verified), so it cannot be used to claim
# somebody else's account; a provider that never sends that claim needs this off and the accounts linked
# by hand.
OIDC_LINK_BY_EMAIL=true
# Set to false to require single sign-on (refused unless OIDC is configured).
LOCAL_LOGIN=true

# Email. Without SMTP_HOST no email is sent and the email features stay hidden.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=guardiano@localhost
DIGEST_HOUR_UTC=7
PASSWORD_RESET_TTL_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Gunicorn workers
WEB_CONCURRENCY=2

# Background worker (the `worker` service)
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=5

# Optional: ask each tracker how its linked tickets are doing, every N hours (0 = never). A ticket the
# tracker calls finished only ever *suggests* resolving the finding; it never changes its status.
TRACKER_POLL_HOURS=0
TRACKER_POLL_LIMIT=100
# Most tickets one scan may open automatically.
AUTO_TICKET_PER_SCAN=20
# Scan uploads per credential, e.g. 60/minute; empty = no limit.
INGEST_RATE_LIMIT=

# ---- Retention --------------------------------------------------------------
# Days to keep each kind of record; 0 keeps it for ever (the default). Findings and their history are
# never removed.
RETENTION_SCAN_DAYS=0
RETENTION_DELIVERY_DAYS=0
RETENTION_AUDIT_DAYS=0

# ---- Metrics ----------------------------------------------------------------
# Prometheus exposition at /metrics on the backend service. Off by default, and never proxied by the
# bundled nginx (it sits outside /api).
METRICS_ENABLED=false
METRICS_TOKEN=
JOB_RETENTION_DAYS=14
